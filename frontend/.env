# Copy this file to .env and set it to your machine's LAN IP when testing
# on a real device (find it via `ipconfig` on Windows, look for IPv4 Address).
# "localhost" only works when running on web or an emulator/simulator on the
# same machine as the backend — not on a physical phone.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000
